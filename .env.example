# Copy to .env and fill in. .env is git-ignored.
TOMTOM_API_KEY=          # optional: live traffic for TripCast
ROADTRUST_YOLO_WEIGHTS=  # optional: path to trained pothole model
ROADTRUST_USE_MOCK=0     # 1 = show labelled demo incidents
ROADTRUST_URL=http://localhost:8002

# ── LLM backend (one of the two blocks below; without either, runs use fixed deterministic checks) ──

# Option A: IBM Bob AI credits (preferred)
# Create an Inference-scoped API key in the Bob web portal, then set:
BOB_API_KEY=             # your Inference-scoped Bob API key
BOB_BASE_URL=            # e.g. https://api.bob.example.com/v1
BOB_MODEL=               # model_name from your Bob model gateway (leave blank to use the default open-weights model)

# Option B: OpenRouter (fallback when BOB_API_KEY is not set)
OPENROUTER_API_KEY=      # enables the LLM agents via OpenRouter
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct   # any OpenRouter model that supports tool calling
