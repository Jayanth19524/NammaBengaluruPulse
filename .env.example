# env vars — copy this file to .env and fill in your values

# --- Node API ---
PORT=4000
NODE_ENV=development

# --- Python Agent ---
PYTHON_AGENT_URL=http://localhost:8000

# --- PostgreSQL (PostGIS) ---
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/waterwatch

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- WaterWatch Agent ---
# Set to "true" to use the mock adapter (no external API calls)
USE_MOCK_ADAPTER=true

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
