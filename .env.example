# Copy to .env and fill in. .env is git-ignored.
TOMTOM_API_KEY=          # optional: live traffic for TripCast
ROADTRUST_YOLO_WEIGHTS=  # optional: path to trained pothole model
ROADTRUST_USE_MOCK=0     # 1 = show labelled demo incidents
ROADTRUST_URL=http://localhost:8002
OPENROUTER_API_KEY=      # enables the LLM agents (RoadTrust + orchestrator); without it they use fixed checks
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct   # any OpenRouter model that supports tool calling
